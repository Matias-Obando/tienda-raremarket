# Copia este archivo a .env y completa con tus datos de Supabase.
# Si usas Session Pooler (recomendado para apps), suele ser puerto 6543.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_USER=postgres.xxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=tu_password
