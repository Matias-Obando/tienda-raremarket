# Supabase Database Configuration
# Obtén estos valores de tu proyecto en Supabase: Settings → Database
# Opción A (recomendada): URL JDBC completa
SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require&user=postgres&password=[YOUR-PASSWORD]

# Opción B: variables separadas (fallback si no defines SPRING_DATASOURCE_URL)
SUPABASE_HOST=your-project.supabase.co
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your-secure-password-here

# Spring
SPRING_DATASOURCE_USERNAME=${SUPABASE_USER}
SPRING_DATASOURCE_PASSWORD=${SUPABASE_PASSWORD}

# Frontend origins allowed to call backend API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

