{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "mvn -B -f backend/pom.xml clean package -DskipTests",
    "watchPatterns": ["/backend/**"]
  },
  "deploy": {
    "startCommand": "java -jar backend/target/backend-0.0.1-SNAPSHOT.jar"
  }
}